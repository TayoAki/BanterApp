# marshmemos environment contract. Copy to apps/server/.env (server) and
# apps/mobile/.env (client). Never commit real values and never paste secrets
# into chats or tickets. Public EXPO_PUBLIC_* variables are bundled into the app
# and must never hold model, storage, or webhook secrets.

# ---------------------------------------------------------------------------
# Client (Expo). Bundled into the app.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_AUTH_MODE=password             # password | fixture (fixture only against a development server)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ---------------------------------------------------------------------------
# Server (API + worker). Server-only. On Railway these are service variables;
# reference variables (${{Postgres.DATABASE_URL}}, ${{Bucket.BUCKET}}, ...) keep
# the values out of the repository.
# ---------------------------------------------------------------------------
APP_ENV=development                # development | test | production
PORT=8787                          # Railway injects PORT
PUBLIC_API_BASE_URL=               # https://<api-domain>; required for local storage URLs
DATABASE_URL=                      # postgres://... (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_POOL_MAX=10

# Accounts
AUTH_MODE=password                 # password | supabase | fixture (fixture only outside production)
AUTH_JWT_SECRET=                   # >= 32 random characters; signs access tokens (generate, never reuse)
AUTH_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TTL_DAYS=60
SUPABASE_URL=                      # only for AUTH_MODE/STORAGE_MODE=supabase
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=

# Object storage (private bucket; the server signs every URL)
STORAGE_MODE=s3                    # s3 | supabase | local (local only outside production)
S3_BUCKET=                         # Railway: ${{Bucket.BUCKET}}
S3_ACCESS_KEY_ID=                  # Railway: ${{Bucket.ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=              # Railway: ${{Bucket.SECRET_ACCESS_KEY}}
S3_REGION=auto                     # Railway: ${{Bucket.REGION}}
S3_ENDPOINT=                       # Railway: ${{Bucket.ENDPOINT}} (https://t3.storageapi.dev)
S3_FORCE_PATH_STYLE=false          # true only if the bucket's Credentials tab says path-style
STORAGE_BUCKET_AUDIO=              # supabase/local only; s3 uses S3_BUCKET
LOCAL_STORAGE_DIR=                 # required when STORAGE_MODE=local

# Models. Text (evaluation, rewrite, verifier, roleplay partner) and audio
# (transcription, speech) are separate providers with separate keys.
PROVIDER_MODE=live                 # live | fixture (fixture only outside production)
TEXT_AI_PROVIDER=openrouter        # openrouter | openai
TEXT_AI_API_KEY=                   # OpenRouter key (sk-or-...) or OpenAI key
TEXT_AI_BASE_URL=                  # default https://openrouter.ai/api/v1 for openrouter
TEXT_AI_API_STYLE=                 # chat | responses (default: chat for openrouter, responses for openai)
EVALUATION_MODEL=                  # default openai/gpt-5 (openrouter) | gpt-5 (openai)
REWRITE_MODEL=                     # default openai/gpt-5 | gpt-5
VERIFIER_MODEL=                    # default openai/gpt-5-mini | gpt-5-mini
ROLEPLAY_MODEL=                    # default openai/gpt-5-mini | gpt-5-mini
AUDIO_AI_PROVIDER=gemini           # gemini | openai
AUDIO_AI_API_KEY=                  # Gemini API key or OpenAI key
AUDIO_AI_BASE_URL=                 # optional override
AUDIO_AI_TRANSCRIBE_API=auto       # auto | interactions | generate_content (Gemini surface for the transcription model)
TRANSCRIPTION_MODEL=               # default gemini-3.5-transcribe (gemini) | gpt-4o-transcribe (openai)
TTS_MODEL=                         # default gemini-3.1-flash-tts-preview (gemini; alt. gemini-2.5-flash-preview-tts) | gpt-4o-mini-tts (openai)
TTS_VOICE=                         # default Kore (gemini) | alloy (openai)
PROMPT_CONFIG_VERSION=prompts-v1
AI_API_KEY=                        # legacy single OpenAI key; fallback for TEXT_AI_API_KEY / AUDIO_AI_API_KEY (openai only)
AI_BASE_URL=

CONTENT_MANIFEST=production        # production | development (development publishes unreviewed drafts; refused in production)

BILLING_PROVIDER=none              # none | revenuecat
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=           # value RevenueCat sends in the Authorization header
REVENUECAT_PRO_ENTITLEMENT_ID=pro
REVENUECAT_ENVIRONMENT=sandbox     # sandbox | production
ALLOW_DEMO_ENTITLEMENTS=false      # never true in production

FREE_SESSIONS_PER_UTC_DAY=1
PRO_SESSIONS_PER_UTC_DAY=10
RESERVATION_TTL_MINUTES=120
RAW_AUDIO_TTL_HOURS=24
TTS_TTL_HOURS=24
PLAYBACK_URL_TTL_SECONDS=300
UPLOAD_URL_TTL_SECONDS=600
MAX_TIMEZONE_CHANGES_PER_DAY=3

WORKER_ID=
WORKER_LEASE_SECONDS=120
WORKER_POLL_MS=1000
TIMEOUT_TRANSCRIBE_MS=60000
TIMEOUT_EVALUATE_MS=30000
TIMEOUT_REWRITE_MS=30000
TIMEOUT_VERIFY_MS=30000
TIMEOUT_TTS_MS=45000

LOG_LEVEL=info
MONITORING_DSN=
